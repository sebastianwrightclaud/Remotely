# Builds the Remotely server from this repository, instead of pulling the
# prebuilt image from Docker Hub.
#
# The agent packages and desktop clients under wwwroot/Content and
# wwwroot/Downloads are build artifacts that aren't kept in git (see
# .gitignore).  Producing them requires Utilities/Publish.ps1, which needs
# Windows and Visual Studio.  Server-side changes don't affect those
# binaries, so they're inherited from the published image instead.
#
# Build from the repository root:
#   docker build -f Server/Dockerfile.source -t remotely-fork:latest .

ARG UPSTREAM_IMAGE=immybot/remotely:latest


FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

# Set this to the release you're currently running, otherwise every agent
# will report as outdated in the web UI.
ARG VERSION=1.0.0.0

# Microsoft.TypeScript.MSBuild compiles Server/wwwroot/src by shelling out to
# node, which isn't in the SDK image.  Debian's nodejs is well past the 14.17
# minimum that TypeScript 5.6 needs.
RUN apt-get -y update && \
    apt-get -y install --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# LibraryRestore=false skips the LibMan restore that Microsoft.Web.LibraryManager.Build
# runs before compiling.  Every library in Server/libman.json is already committed
# under Server/wwwroot/lib, so the restore adds nothing, but it reaches out to cdnjs
# and unpkg during the build and fails when they can't resolve a version or aren't
# reachable from the build container.
RUN dotnet publish ./Server/Server.csproj \
      --configuration Release \
      /p:Version=${VERSION} \
      /p:FileVersion=${VERSION} \
      /p:LibraryRestore=false \
      --output /app/publish


FROM ${UPSTREAM_IMAGE} AS upstream


FROM mcr.microsoft.com/dotnet/aspnet:8.0

EXPOSE 5000

RUN apt -y update && \
    apt -y install curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish/ /app/

# Overlay only the agent installers and desktop clients, which are generated by
# Utilities/Publish.ps1 on Windows and can't be built here.  Taking upstream's
# whole wwwroot instead would let its compiled assets shadow this build's --
# notably Remotely_Server.styles.css, the Blazor scoped-CSS bundle, whose
# generated b-* selectors only match components from the same build.
COPY --from=upstream /app/wwwroot/Content/ /app/wwwroot/Content/

WORKDIR /app

ENTRYPOINT ["dotnet", "Remotely_Server.dll"]

HEALTHCHECK \
  CMD curl -f http://localhost:${ASPNETCORE_HTTP_PORTS}/api/healthcheck || exit 1
